# Claude: an Anthropic API key (or run `ant auth login` instead of setting one)...
ANTHROPIC_API_KEY=

# ...or route through a LiteLLM gateway. ANTHROPIC_API_KEY is then your LiteLLM virtual key.
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
# Gateway behind Google Cloud IAP? Uses your `gcloud auth application-default login`.
# LITELLM_IAP=1
# LITELLM_IAP_SERVICE_ACCOUNT=name@project.iam.gserviceaccount.com
# LITELLM_IAP_AUDIENCE=             # defaults to <gateway>/*

# Models (names as your API or gateway knows them; check with `uv run slopbot models`)
SLOPBOT_MODEL=claude-opus-5-5
# SLOPBOT_JUDGE_MODEL=              # defaults to SLOPBOT_MODEL
# SLOPBOT_GEN_MODEL=                # defaults to SLOPBOT_MODEL
SLOPBOT_EFFORT=medium               # low | medium | high | xhigh | max
# SLOPBOT_FALLBACKS=off             # refusal fallback; default on direct, off with a gateway

# Slack app (see README > Setting up Slack)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Braintrust: logging, feedback, datasets, evals. Leave empty to turn it off.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=Slopbot
# BRAINTRUST_PROJECT_ID=            # use an existing project by ID (wins over the name)
# SLOPBOT_BRAINTRUST_LOGGING=off    # keep the key for evals but don't log real traffic

# Evals
# SLOPBOT_JUDGE_EFFORT=medium
# SLOPBOT_EVAL_MODELS=candidates     # compare models: one experiment each (see evals/models.py)
# SLOPBOT_GEN_MODELS=mixed          # dataset AI examples from several labs
# SLOPBOT_TRIALS=1
# SLOPBOT_EVAL_CONCURRENCY=8
