# Claude (or run `ant auth login` instead of setting a key)
ANTHROPIC_API_KEY=

# Slack app (see README > Slack setup)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Braintrust: tracing, feedback, datasets, evals. Leave empty to disable logging.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=Slopbot
# SLOPBOT_BRAINTRUST_LOGGING=off   # keep the key for evals but don't log production traffic

# Detector
SLOPBOT_MODEL=claude-opus-5-5
SLOPBOT_EFFORT=medium              # low | medium | high | xhigh | max
# SLOPBOT_FALLBACKS=off            # disable server-side refusal fallback

# Evals
# SLOPBOT_JUDGE_MODEL=claude-opus-5-5
# SLOPBOT_JUDGE_EFFORT=medium
# SLOPBOT_TRIALS=1
# SLOPBOT_EVAL_CONCURRENCY=8
